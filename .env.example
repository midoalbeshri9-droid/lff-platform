# ===== قاعدة البيانات (PostgreSQL) =====
# افتراضيًا: قاعدة مدمجة داخل المشروع (مجلد data) — لا تحتاج تثبيت أي برنامج
#   DATABASE_URL="pglite:./data/db"
# Neon / خادم PostgreSQL (عند النشر): ضع رابط الاتصال واجعل DATABASE_SSL="true"
#   DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DATABASE_URL="pglite:./data/db"
DIRECT_URL="pglite:./data/db"
# اجعلها true عند الاتصال بـ Neon أو أي قاعدة سحابية
DATABASE_SSL="false"

# ===== الأمان =====
# سلسلة عشوائية طويلة (32 حرفًا على الأقل) — لا تشاركها مع أحد
AUTH_SECRET="غيّر-هذه-القيمة-إلى-سلسلة-عشوائية-طويلة-جدا-1234567890"

# رابط المنظومة (يُستخدم في رمز QR على البطاقات)
APP_URL="http://localhost:3000"

# ===== تخزين الملفات =====
# local = مجلد على الجهاز (للتجربة المحلية)
# s3    = Cloudflare R2 (إلزامي عند النشر على Vercel)
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
# إعدادات R2 (عند STORAGE_DRIVER=s3)
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="lff-files"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ===== البريد الإلكتروني (رسائل التفعيل واستعادة كلمة المرور) =====
# بدون هذه الإعدادات تُحفظ الرسائل في «صندوق الرسائل» داخل الإدارة ويمكن نسخ الروابط منه
# Gmail: فعّل التحقق بخطوتين ثم أنشئ «كلمة مرور التطبيقات» من myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="الاتحاد الليبي لكرة القدم <your.account@gmail.com>"

# ===== الرسائل القصيرة SMS (لاحقًا عند التعاقد مع مزود) =====
SMS_PROVIDER_URL=""
SMS_API_KEY=""
SMS_SENDER="LFF"

# كلمة مرور المدير الأولية عند التهيئة
SEED_ADMIN_PASSWORD="Admin@12345"
